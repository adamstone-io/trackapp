DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.local
REGISTRATION_CODE=4595
# Free trial length for new accounts (days), starting when email is verified
TRIAL_DAYS=7

# Optional: set in production (example: postgres://user:pass@host:5432/dbname)
DATABASE_URL=

# Email verification (Resend)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com
FRONTEND_URL=https://your-frontend-url.com

# Comma-separated CORS origins for deployed frontend(s)
CORS_ALLOWED_ORIGINS=

# Optional extra CORS origins while DEBUG=True
DEV_LIVE_CORS_ALLOWED_ORIGINS=
